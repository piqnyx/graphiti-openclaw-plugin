{
  "id": "graphiti-openclaw-plugin",
  "name": "Graphiti Companion",
  "description": "Graphiti companion plugin for OpenClaw",
  "activation": {
    "onStartup": true,
    "onCapabilities": ["hook"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string" },
      "autoCapture": { "type": "boolean" },
      "autoRecall": { "type": "boolean" },
      "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
      "recallLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
      "recallQueryMaxChars": { "type": "integer", "minimum": 32, "maximum": 32000 },
      "recallMaxInjectedChars": { "type": "integer", "minimum": 128, "maximum": 64000 },
      "recallUseHistory": { "type": "boolean" },
      "recallHistoryMaxMessages": { "type": "integer", "minimum": 1, "maximum": 100 },
      "recallHistoryMaxChars": { "type": "integer", "minimum": 128, "maximum": 32000 },
      "logOperations": { "type": "boolean" },
      "logLevel": { "type": "string", "enum": ["error", "warn", "info", "debug"] },
      "logContent": { "type": "boolean" },
      "bufferLimit": { "type": "integer", "minimum": 1, "maximum": 1000 },
      "bufferTimeout": { "type": "integer", "minimum": 30, "maximum": 604800 },
      "agents": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user", "assistant"],
          "properties": {
            "user": { "type": "string", "minLength": 1 },
            "assistant": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
