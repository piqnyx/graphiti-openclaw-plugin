{
  "id": "graphiti-openclaw-plugin",
  "name": "Graphiti Companion",
  "description": "Graphiti companion plugin for OpenClaw",
  "activation": {
    "onStartup": true,
    "onCapabilities": [
      "hook",
      "tool"
    ]
  },
  "contracts": {
    "tools": [
      "graphiti_search",
      "graphiti_browse",
      "graphiti_note",
      "graphiti_repair",
      "graphiti_status"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string"
      },
      "autoCapture": {
        "type": "boolean"
      },
      "autoRecall": {
        "type": "boolean"
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 300000
      },
      "recallLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "recallQueryMaxChars": {
        "type": "integer",
        "minimum": 32,
        "maximum": 32000
      },
      "recallMaxInjectedChars": {
        "type": "integer",
        "minimum": 128,
        "maximum": 64000
      },
      "recallUseHistory": {
        "type": "boolean"
      },
      "recallHistoryMaxMessages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "recallHistoryMaxChars": {
        "type": "integer",
        "minimum": 128,
        "maximum": 32000
      },
      "logOperations": {
        "type": "boolean"
      },
      "logLevel": {
        "type": "string",
        "enum": [
          "error",
          "warn",
          "info",
          "debug"
        ]
      },
      "logContent": {
        "type": "boolean"
      },
      "logModelInput": {
        "type": "boolean"
      },
      "bufferLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      },
      "bufferTimeout": {
        "type": "integer",
        "minimum": 30,
        "maximum": 604800
      },
      "agentTools": {
        "type": "boolean",
        "description": "Register the graphiti_* tools so agents can query and write memory on demand. Which agent may call which tool is still governed by the OpenClaw per-agent tool allowlist."
      },
      "excludeSessionPatterns": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": "Regular expressions tested against the OpenClaw session key and the run trigger. A match excludes the session from both capture and recall. Replaces the previously hardcoded cron/heartbeat/subagent/slug-generator filtering; overriding this list overrides that too."
      },
      "agents": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user",
            "assistant"
          ],
          "properties": {
            "user": {
              "type": "string",
              "minLength": 1
            },
            "assistant": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "browseChars": {
        "type": "integer",
        "minimum": 128,
        "maximum": 200000,
        "description": "Characters of conversation graphiti_browse reads on each side of an anchor by default."
      },
      "browseMaxChars": {
        "type": "integer",
        "minimum": 128,
        "maximum": 200000,
        "description": "Ceiling on before/after in one graphiti_browse call."
      },
      "browseMaxEpisodes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "How many anchors graphiti_browse will expand in one call."
      },
      "browseMaxTotalChars": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 1000000,
        "description": "Total size of one graphiti_browse reply. What does not fit is reported as omitted rather than silently dropped."
      },
      "agentDbPath": {
        "type": "string",
        "description": "Path to an agent's OpenClaw transcript store; {agentId} is substituted. Empty uses ~/.openclaw/agents/{agentId}/agent/openclaw-agent.sqlite."
      },
      "adoptExistingHistoryOnFirstSight": {
        "type": "boolean",
        "description": "Skip a session's existing rows the first time it is seen. Off by default; only correct when that history is already in memory and reading it again would duplicate episodes."
      }
    }
  }
}
