{
  "id": "graphiti-openclaw-plugin",
  "name": "Graphiti Companion",
  "description": "Graphiti companion plugin for OpenClaw",
  "activation": {
    "onStartup": true,
    "onCapabilities": ["hook"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string" },
      "autoCapture": { "type": "boolean" },
      "autoRecall": { "type": "boolean" },
      "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
      "recallLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
      "recallQueryMaxChars": { "type": "integer", "minimum": 32, "maximum": 32000 },
      "recallMaxInjectedChars": { "type": "integer", "minimum": 128, "maximum": 64000 },
      "logOperations": { "type": "boolean" },
      "logLevel": { "type": "string", "enum": ["error", "warn", "info", "debug"] },
      "logContent": { "type": "boolean" },
      "bufferLimit": { "type": "integer", "minimum": 4, "maximum": 1000 },
      "bufferTimeout": { "type": "integer", "minimum": 120, "maximum": 604800 },
      "participants": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "name"],
          "properties": {
            "role": { "type": "string", "enum": ["user", "assistant"] },
            "name": { "type": "string", "minLength": 1 },
            "aliases": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
