{
  "name": "graphiti-openclaw-plugin",
  "version": "0.1.0",
  "displayName": "Graphiti Companion",
  "description": "Slot-less OpenClaw companion plugin for per-agent Graphiti auto-capture and auto-recall",
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "files": [
    "dist/",
    "README.md",
    "TECHNICAL_SPEC.md",
    "TODO.md",
    "openclaw.plugin.json",
    "package.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json --noEmit false --outDir dist --rootDir src",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=22",
    "openclaw": ">=2026.8.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  },
  "keywords": [
    "openclaw",
    "graphiti",
    "falkordb",
    "plugin",
    "memory",
    "knowledge-graph",
    "multi-agent",
    "auto-recall",
    "auto-capture"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/piqnyx/graphiti-openclaw-plugin.git"
  },
  "homepage": "https://github.com/piqnyx/graphiti-openclaw-plugin",
  "license": "MIT",
  "author": "piqnyx",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "5.9.3"
  },
  "bugs": {
    "url": "https://github.com/piqnyx/graphiti-openclaw-plugin/issues"
  }
}
